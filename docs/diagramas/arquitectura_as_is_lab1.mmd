graph TD
    %% ========================================================
    %% TITULO DEL DIAGRAMA
    %% Arquitectura As-Is — API Riesgo Crediticio — FinTech Nova
    %% Laboratorio 1 — Roslaysoft Consulting
    %% ========================================================

    %% ── ACTOR EXTERNO ─────────────────────────────────────
    Cliente(["Cliente FinTech Nova\nApp Movil / Web Browser"]):::actor

    %% ── ZONA INTERNET ─────────────────────────────────────
    subgraph Internet[" INTERNET / Red Publica"]
        Canal["HTTPS / TLS 1.3\nPuerto público del Codespace"]
    end

    %% ── GITHUB CODESPACES ─────────────────────────────────
    subgraph Codespaces[" GitHub Codespaces | Microsoft Azure"]

        subgraph Contenedor[" Contenedor Linux Efímero | VS Code Server"]

            subgraph FastAPI[" FastAPI Application | uvicorn | Puerto 8000"]
