                EP2["GET /status\nHealth Check"]:::endpoint_monitor
                EP3["GET /datos-financieros/{id}\n VULNERABLE — Sin Autenticación"]:::endpoint_vuln
            end

        end
    end

    %% ── CONEXIONES / FLUJOS ───────────────────────────────
